[user]
	name = Bernie Gray
	email = bfgray3@gmail.com
[alias]
	s = status
	d = diff
	l = log --all --graph --decorate
	b = branch
	poh = push origin HEAD
	rph = rev-parse HEAD
	cob = "!git fetch origin HEAD && git checkout origin/HEAD -b \"$1\" #"
	merge-main = "!git fetch origin HEAD && git merge origin/HEAD"
[core]
	editor = vim
[fetch]
	prune = true
